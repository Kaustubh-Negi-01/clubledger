# --- Supabase (leave empty to run the built-in demo database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for receipt storage and the cron route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/maintenance (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Optional: restrict sign-in to these Google/email domains (comma separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=
