# --- Supabase (leave empty to run the built-in demo database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for receipt storage and the cron route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/maintenance (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Optional extra app-level check on sign-in domains (comma separated). The authoritative setting lives in
# the database (Admin > Team > Deployment settings). Empty = no extra check.
ALLOWED_EMAIL_DOMAINS=

# Production safety: set to 1 ONLY if you deliberately want the in-memory demo club on a production deployment.
DEMO_MODE=
