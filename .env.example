# Copy this file to .env in the repository root for your local settings.
# Shell environment variables override .env values.
CLUBLEDGER_ENV=dev
CLUBLEDGER_HOST=127.0.0.1
CLUBLEDGER_PORT=8010
CLUBLEDGER_DB_PATH=database/runtime/clubledger-preview.db

# Optional: defaults to a receipts folder next to the database.
# CLUBLEDGER_RECEIPTS_DIR=database/runtime/receipts

# Optional in dev/test; REQUIRED in prod. Never commit a real secret here.
# CLUBLEDGER_SIM_SECRET=replace-with-a-long-random-secret

# Payment webhooks use the local simulator; local email is captured, not sent.
# Real email is opt-in and needs a provider account and verified sender.
# CLUBLEDGER_MAIL_MODE=resend
# Alternative for a verified Brevo sender without an owned domain:
# CLUBLEDGER_MAIL_MODE=brevo
# BREVO_API_KEY=configure-privately-never-commit
# Supported SMTP alternative (use its SMTP key, not the API key):
# CLUBLEDGER_MAIL_MODE=brevo_smtp
# BREVO_SMTP_LOGIN=copy-from-your-provider-dashboard
# BREVO_SMTP_KEY=configure-privately-never-commit
# RESEND_API_KEY=server-only-provider-key
# CLUBLEDGER_MAIL_FROM=club@your-verified-domain.com
# CLUBLEDGER_SITE_URL=https://clubledger-gold.vercel.app
# CRON_SECRET=generate-at-least-32-random-characters

# Hosted deployment: server-only Supabase transaction-pooler URI (TLS required).
# CLUBLEDGER_DATABASE_URL=postgresql://USER:PASSWORD@POOLER:6543/postgres?sslmode=require
# Set CLUBLEDGER_ENV=prod and CLUBLEDGER_SIM_SECRET to a stable random secret.
# Uploaded receipt bytes persist privately in PostgreSQL; cloud limit is 3 MB.

# Show the seeded demo login hints explicitly, including with prod security enabled.
# CLUBLEDGER_DEMO_ACCOUNTS=1
